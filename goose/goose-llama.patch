+// The runtime and helper names emitted kernels may use, all of which the
+// prelude defines; any other gs_ name is something with no device form.
+inline bool CudaKnownName(string_view n) {
+    static const string pre = cuda_prelude;
+    return pre.find(cat(" ", n, " ")) != string::npos || pre.find(cat(" ", n, "(")) != string::npos ||
+           pre.find(cat(" ", n, ";")) != string::npos || pre.find(cat("define ", n, "\n")) != string::npos;
+}
+
+// nvcc, from CUDA_PATH or PATH; "" for none.
+inline string NvccPath() {
+    if (auto cp = getenv("CUDA_PATH")) {
+        auto p = cat(cp, "/bin/nvcc");
+        #ifdef _WIN32
+            p += ".exe";
+        #endif
+        if (PathExists(p)) return p;
+    }
+    return FindOnPath("nvcc");
+}
+
+// Compiles the kernels in `cu` to PTX at `stem`.ptx, for the GPU this machine
+// has unless GOOSE_CUDA_ARCH names another (sm_89, compute_80, ...).
+inline bool BuildCuda(const string &cu, const string &stem, string &ptx, string &err) {
+    auto nvcc = NvccPath();
+    if (nvcc.empty()) {
+        err = "cuda fn needs nvcc: install the CUDA toolkit or set CUDA_PATH";
+        return false;
+    }
+    #ifdef _WIN32
+        // nvcc preprocesses with cl.
+        if (FindOnPath("cl").empty() && !ImportVcvars(false)) {
+            err = "nvcc needs Visual Studio's cl, which was not found";
+            return false;
+        }
+    #endif
+    // A fatbin: the GPU's own code, so loading it compiles nothing, and PTX
+    // for the GPUs after it.
+    auto cufile = stem + ".cu", ptxfile = stem + ".fatbin";
+    if (!WriteFileMakingDirs(cufile, cu)) {
+        err = cat("cannot write ", cufile);
+        return false;
+    }
+    auto arch = getenv("GOOSE_CUDA_ARCH");
+    vector<string> argv = { nvcc, "-fatbin", "-O3", cat("-arch=", arch && *arch ? arch : "native"),
+                            "-o", ptxfile, cufile };
+    // GOOSE_NVCC_FLAGS: more of nvcc's options, split at spaces.
+    if (auto extra = getenv("GOOSE_NVCC_FLAGS")) {
+        string w;
+        for (auto p = extra;; p++) {
+            if (*p && *p != ' ') { w += *p; continue; }
+            if (!w.empty()) argv.insert(argv.end() - 3, w);
+            w.clear();
+            if (!*p) break;
+        }
+    }
+    auto r = RunProcess(argv);
+    if (!r.started || r.code != 0 || !LoadFile(ptxfile, ptx)) {
+        err = cat("nvcc failed on ", cufile, ":\n", r.output);
+        return false;
+    }
+    return true;
+}
