+                       a[16 + 2 * k] * b[16 + 2 * k] + a[17 + 2 * k] * b[17 + 2 * k]);
+}
+/* dot_quads: lane k is the sum over j = 4k..4k+3 of min(a[j], 127) * b[j].
+   The cap keeps every pair of products inside AVX2's saturating 16-bit
+   multiply-add, so its four instructions are exact and give the loop's lanes. */
+static inline void gs_dot_quads_0(float *r, const uint8_t *a, const int8_t *b) {
+    for (int k = 0; k < 8; k++) {
+        int s = 0;
+        for (int j = 4 * k; j < 4 * k + 4; j++) s += (a[j] < 127 ? a[j] : 127) * b[j];
+        r[k] = (float)s;
+    }
+}
+static inline void gs_dot_quads_i8_0(float *r, const int8_t *a, const int8_t *b) {
+    for (int k = 0; k < 8; k++) {
+        int s = 0;
+        for (int j = 4 * k; j < 4 * k + 4; j++)
+            s += (a[j] < -127 ? -127 : a[j]) * (b[j] < -127 ? -127 : b[j]);
+        r[k] = (float)s;
+    }
+}
+static inline void gs_dot_quads_s_0(int32_t *r, const uint8_t *a, const int8_t *b, const int16_t *s) {
+    for (int k = 0; k < 8; k++) {
+        int p[2];
+        for (int h = 0; h < 2; h++) {
+            int j = 4 * k + 2 * h;
+            p[h] = (a[j] < 127 ? a[j] : 127) * b[j] + (a[j + 1] < 127 ? a[j + 1] : 127) * b[j + 1];
+        }
+        r[k] = p[0] * s[2 * k] + p[1] * s[2 * k + 1];
+    }
+}
+static inline void gs_dot_quads_s_i8_0(int32_t *r, const int8_t *a, const int8_t *b, const int16_t *s) {
+    for (int k = 0; k < 8; k++) {
+        int p[2];
+        for (int h = 0; h < 2; h++) {
+            int j = 4 * k + 2 * h;
+            p[h] = (a[j] < -127 ? -127 : a[j]) * (b[j] < -127 ? -127 : b[j]) +
+                   (a[j + 1] < -127 ? -127 : a[j + 1]) * (b[j + 1] < -127 ? -127 : b[j + 1]);
+        }
+        r[k] = p[0] * s[2 * k] + p[1] * s[2 * k + 1];
+    }
+}
+static inline void gs_dot_bytes_0(int32_t *r, const uint8_t *a, const int8_t *b) {
+    for (int k = 0; k < 8; k++)
+        r[k] = a[4 * k] * b[4 * k] + a[4 * k + 1] * b[4 * k + 1] + a[4 * k + 2] * b[4 * k + 2] + a[4 * k + 3] * b[4 * k + 3];
+}
+static inline void gs_dot_bytes_acc_0(int32_t *r, const uint8_t *a, const int8_t *b, const int32_t *c) {
+    for (int k = 0; k < 8; k++)
+        r[k] = (int32_t)((uint32_t)c[k] + (uint32_t)(a[4 * k] * b[4 * k] + a[4 * k + 1] * b[4 * k + 1] +
+                                                     a[4 * k + 2] * b[4 * k + 2] + a[4 * k + 3] * b[4 * k + 3]));
+}
+static inline void gs_dot_quads_i_0(int32_t *r, const uint8_t *a, const int8_t *b, const int32_t *c) {
+    for (int k = 0; k < 8; k++) {
+        int s = 0;
+        for (int j = 4 * k; j < 4 * k + 4; j++) s += (a[j] < 127 ? a[j] : 127) * b[j];
+        r[k] = (int32_t)((uint32_t)c[k] + (uint32_t)s);
+    }
+}
+static inline void gs_dot_quads_i_i8_0(int32_t *r, const int8_t *a, const int8_t *b, const int32_t *c) {
+    for (int k = 0; k < 8; k++) {
+        int s = 0;
+        for (int j = 4 * k; j < 4 * k + 4; j++)
+            s += (a[j] < -127 ? -127 : a[j]) * (b[j] < -127 ? -127 : b[j]);
+        r[k] = (int32_t)((uint32_t)c[k] + (uint32_t)s);
+    }
+}
+static inline void gs_madd16_0(int32_t *r, const int16_t *a, const int16_t *b) {
+    for (int k = 0; k < 8; k++)
