+// math's round_even (stdlib): nearest integer, ties to even, at both widths,
+// the same in a simd function's versions as in the baseline.
+import std;
+import math;
+
+simd fn quant(x: const f32[:], o: i8[>..]&) { for v in x { o.push(round_even(v) as i8); } }
+
+fn main() {
+    let a: f64[] = [0.5, 1.5, 2.5, -0.5, -1.5, -2.5, 2.4999, -2.5001, 0.0, -0.0, 1e300, -4503599627370497.0];
+    for v in a { print(round_even(v)); }
+    let b: f32[] = [0.5, 1.5, 2.5, -0.5, -3.5, 126.5, -126.5, 8388609.0];
+    for v in b { print(round_even(v)); }
+    var x: f32[>..] = [];
+    for i in 64 { x.push((i as f32 - 32) * 0.5); }
+    var o: i8[>..] = [];
+    quant(x, o);
+    print(o);
+}
diff --git a/test/codegen/simd_dot_lanes.goose b/test/codegen/simd_dot_lanes.goose
new file mode 100644
index 0000000..793ca71
--- /dev/null
+++ b/test/codegen/simd_dot_lanes.goose
@@ -0,0 +1,131 @@
+// dot_lanes (§12, reference §25): lane k of the f32[8] is a[2k]*b[2k] +
+// a[2k+1]*b[2k+1] + a[16+2k]*b[16+2k] + a[17+2k]*b[17+2k], exact in every
+// version: the plain function, a simd function's AVX2 and AVX-512 bodies,
+// and code built for AVX2 as a whole. The extremes of both operand types.
+import std;
+
+fn plain(a: i8[32], b: i8[32]) -> f32[8] { dot_lanes(a, b) }
+simd fn vec(a: i8[32], b: i8[32]) -> f32[8] { dot_lanes(a, b) }
+fn plainu(a: u8[32], b: i8[32]) -> f32[8] { dot_lanes(a, b) }
+simd fn vecu(a: u8[32], b: i8[32]) -> f32[8] { dot_lanes(a, b) }
+
+fn want(a: i8[32], b: i8[32]) -> f32[8] {
+    var r: f32[8] = [0.0; 8];
+    for k in 8 { r[k] = a[2 * k] as i32 * b[2 * k] + a[2 * k + 1] as i32 * b[2 * k + 1] + a[16 + 2 * k] as i32 * b[16 + 2 * k] + a[17 + 2 * k] as i32 * b[17 + 2 * k]; }
+    return r;
+}
+fn wantu(a: u8[32], b: i8[32]) -> f32[8] {
+    var r: f32[8] = [0.0; 8];
+    for k in 8 { r[k] = a[2 * k] as i32 * b[2 * k] + a[2 * k + 1] as i32 * b[2 * k + 1] + a[16 + 2 * k] as i32 * b[16 + 2 * k] + a[17 + 2 * k] as i32 * b[17 + 2 * k]; }
+    return r;
+}
+
+// A kernel accumulates the lanes across blocks and sums them once.
+simd fn dot(a: const i8[:], b: const i8[:]) -> f32 {
+    var acc: f32[8] = [0.0; 8];
+    for i in a.len / 32 {
+        var x: i8[32] = [0; 32];
+        var y: i8[32] = [0; 32];
+        for j in 32 { x[j] = a[i * 32 + j]; y[j] = b[i * 32 + j]; }
+        acc = acc + dot_lanes(x, y) * 0.5;
+    }
+    return acc[0] + acc[1] + acc[2] + acc[3] + acc[4] + acc[5] + acc[6] + acc[7];
+}
+
+fn main() {
+    var lo: i8[32] = [-128; 32];
+    var hi: i8[32] = [127; 32];
+    var uhi: u8[32] = [255; 32];
+    print(plain(lo, lo), " ", vec(lo, lo));
+    print(plain(lo, hi), " ", vec(lo, hi));
+    print(plainu(uhi, lo), " ", vecu(uhi, lo));
+    var r = rng { 11 };
+    var bad = 0;
+    for it in 500 {
+        var a: i8[32] = [0; 32];
+        var b: i8[32] = [0; 32];
+        var u: u8[32] = [0; 32];
+        for j in 32 { a[j] = (r.rand_int(256) - 128) as! i8; b[j] = (r.rand_int(256) - 128) as! i8; u[j] = r.rand_int(256) as! u8; }
+        let w = want(a, b);
+        let wu = wantu(u, b);
+        if plain(a, b) != w || vec(a, b) != w || plainu(u, b) != wu || vecu(u, b) != wu { bad++; }
+    }
+    print("mismatches ", bad);
+    var a: i8[>..] = [];
+    var b: i8[>..] = [];
+    for i in 320 { a.push((i % 7 - 3) as i8); b.push((i % 5 - 2) as i8); }
+    print(dot(a, b));
+    main_quads();
+}
+
+fn plainq(a: u8[32], b: i8[32]) -> f32[8] { dot_quads(a, b) }
+fn plainqs(a: i8[32], b: i8[32]) -> f32[8] { dot_quads(a, b) }
+simd fn vecqs(a: i8[32], b: i8[32]) -> f32[8] { dot_quads(a, b) }
+simd fn vecq(a: u8[32], b: i8[32]) -> f32[8] { dot_quads(a, b) }
+fn plainsq(a: u8[32], b: i8[32], s: i16[16]) -> i32[8] { dot_quads_s(a, b, s) }
+simd fn vecsq(a: u8[32], b: i8[32], s: i16[16]) -> i32[8] { dot_quads_s(a, b, s) }
+fn plainsqs(a: i8[32], b: i8[32], s: i16[16]) -> i32[8] { dot_quads_s(a, b, s) }
+simd fn vecsqs(a: i8[32], b: i8[32], s: i16[16]) -> i32[8] { dot_quads_s(a, b, s) }
+fn plainma(a: i16[16], b: i16[16]) -> i32[8] { madd16(a, b) }
+fn plainby(a: u8[32], b: i8[32]) -> i32[8] { dot_bytes(a, b) }
+simd fn vecby(a: u8[32], b: i8[32]) -> i32[8] { dot_bytes(a, b) }
+fn plainbc(a: u8[32], b: i8[32], c: i32[8]) -> i32[8] { dot_bytes(a, b, c) }
+fn plainqi(a: u8[32], b: i8[32], c: i32[8]) -> i32[8] { dot_quads_i(a, b, c) }
+simd fn vecqi(a: u8[32], b: i8[32], c: i32[8]) -> i32[8] { dot_quads_i(a, b, c) }
+fn plainqi8(a: i8[32], b: i8[32], c: i32[8]) -> i32[8] { dot_quads_i(a, b, c) }
+simd fn vecqi8(a: i8[32], b: i8[32], c: i32[8]) -> i32[8] { dot_quads_i(a, b, c) }
+simd fn vecbc(a: u8[32], b: i8[32], c: i32[8]) -> i32[8] { dot_bytes(a, b, c) }
+simd fn vecma(a: i16[16], b: i16[16]) -> i32[8] { madd16(a, b) }
+fn main_quads() {
+    var r = rng { 5 };
+    var bad = 0;
+    for it in 500 {
+        var a: u8[32] = [0; 32];
+        var b: i8[32] = [0; 32];
+        for j in 32 { a[j] = r.rand_int(256) as! u8; b[j] = (r.rand_int(256) - 128) as! i8; }
+        var w: f32[8] = [0.0; 8];
+        for k in 8 { var s = 0; for j in 4 * k..4 * k + 4 { s += min(a[j] as i64, 127) * b[j]; } w[k] = s; }
+        if plainq(a, b) != w || vecq(a, b) != w { bad++; }
+        var sa: i8[32] = [0; 32];
+        for j in 32 { sa[j] = (r.rand_int(256) - 128) as! i8; }
+        var ws: f32[8] = [0.0; 8];
+        for k in 8 { var s = 0; for j in 4 * k..4 * k + 4 { s += max(sa[j] as i64, -127) * max(b[j] as i64, -127); } ws[k] = s; }
+        if plainqs(sa, b) != ws || vecqs(sa, b) != ws { bad++; }
+        var sc: i16[16] = [0; 16];
+        var sd: i16[16] = [0; 16];
+        for j in 16 { sc[j] = (r.rand_int(65536) - 32768) as! i16; sd[j] = (r.rand_int(65536) - 32768) as! i16; }
+        var wi: i32[8] = [0; 8];
+        var wis: i32[8] = [0; 8];
+        var wm: i32[8] = [0; 8];
+        for k in 8 {
+            var p: i64 = 0;
+            var q: i64 = 0;
+            for j in 4 * k..4 * k + 4 { p += min(a[j] as i64, 127) * b[j] * sc[j / 2]; q += max(sa[j] as i64, -127) * max(b[j] as i64, -127) * sc[j / 2]; }
+            wi[k] = p as i32;
+            wis[k] = q as i32;
+            wm[k] = (sc[2 * k] as i64 * sd[2 * k] + sc[2 * k + 1] as i64 * sd[2 * k + 1]) as i32;
+        }
+        var wb: i32[8] = [0; 8];
+        for k in 8 { var q: i64 = 0; for j in 4 * k..4 * k + 4 { q += a[j] as i64 * b[j]; } wb[k] = q as i32; }
+        if plainby(a, b) != wb || vecby(a, b) != wb { bad++; }
+        var cc: i32[8] = [0; 8];
+        var wc: i32[8] = [0; 8];
+        for k in 8 { cc[k] = (r.rand_int(1 << 32) - (1 << 31)) as! i32; wc[k] = (cc[k] as i64 + wb[k]) as! i32; }
+        if plainbc(a, b, cc) != wc || vecbc(a, b, cc) != wc { bad++; }
+        var wq: i32[8] = [0; 8];
+        var wq8: i32[8] = [0; 8];
+        for k in 8 {
+            var p: i64 = 0;
+            var q: i64 = 0;
+            for j in 4 * k..4 * k + 4 { p += min(a[j] as i64, 127) * b[j]; q += max(sa[j] as i64, -127) * max(b[j] as i64, -127); }
+            wq[k] = (cc[k] + p) as! i32;
+            wq8[k] = (cc[k] + q) as! i32;
+        }
+        if plainqi(a, b, cc) != wq || vecqi(a, b, cc) != wq || plainqi8(sa, b, cc) != wq8 || vecqi8(sa, b, cc) != wq8 { bad++; }
+        if plainsq(a, b, sc) != wi || vecsq(a, b, sc) != wi || plainsqs(sa, b, sc) != wis || vecsqs(sa, b, sc) != wis || plainma(sc, sd) != wm || vecma(sc, sd) != wm { bad++; }
+    }
+    var a: u8[32] = [255; 32];
+    var b: i8[32] = [-128; 32];
+    var c: i8[32] = [-128; 32];
+    print("quads ", vecq(a, b), " ", vecqs(c, b), " ", vecsq(a, b, [-32768; 16]), " ", vecsqs(c, b, [3; 16]), " ", vecma([-32768; 16], [-32768; 16]), " ", vecby(a, b), " mismatches ", bad);
+}
