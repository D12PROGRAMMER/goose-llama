diff --git a/stdlib/cuda.goose b/stdlib/cuda.goose
new file mode 100644
index 0000000..71a09de
--- /dev/null
+++ b/stdlib/cuda.goose
@@ -0,0 +1,37 @@
+// The Goose standard library: `cuda` (docs/stdlib.md): the GPU through
+// CUDA's driver. A buf<T> is n Ts of device memory; a `cuda fn` takes one
+// for each slice parameter from cuda_launch(kernel, blocks, threads, ...),
+// which returns before the kernel finishes. Copies wait for the kernels
+// launched before them; sync waits for all of them.
+
+namespace cuda;
+
+struct buf<T> { p: u64, n: i64 }
+
+extern fn init() -> bool = "gs_cuda_init";               // false where there is no CUDA device
+extern fn device_name(out: u8[>..]&) -> bool = "gs_cuda_name";
+extern fn memory() -> i64 = "gs_cuda_memory";            // the device's bytes
+extern fn free_bytes(p: u64) = "gs_cuda_free";
+extern fn sync() = "gs_cuda_sync";
+// The launches between capture_begin and capture_end are recorded, not run:
+// graph_run replays them all with one call.
+extern fn capture_begin() = "gs_cuda_capture_begin";
+extern fn capture_end() -> u64 = "gs_cuda_capture_end";
+extern fn graph_run(g: u64) = "gs_cuda_graph_run";
+// A side line of launches: those after fork run after what came before it,
+// beside the main line, to which back returns; join makes the main line's
+// next launches wait for the side line's.
+extern fn fork() = "gs_cuda_fork";
+extern fn back() = "gs_cuda_back";
+extern fn join() = "gs_cuda_join";
+
+fn alloc<T>(n: i64) -> buf<T> { buf<T> { p: cuda_alloc<T>(n), n: n } }
+fn free<T>(b: buf<T>) { free_bytes(b.p); }
+fn upload<T>(b: buf<T>, s: const T[:]) {
+    assert(s.len <= b.n);
+    cuda_copy_in(b.p, s);
+}
+fn download<T>(b: buf<T>, s: T[:]) {
+    assert(s.len <= b.n);
+    cuda_copy_out(s, b.p);
+}
