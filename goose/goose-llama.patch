diff --git a/test/codegen/prefetch.goose b/test/codegen/prefetch.goose
new file mode 100644
index 0000000..31b10e3
--- /dev/null
+++ b/test/codegen/prefetch.goose
@@ -0,0 +1,27 @@
+// a.prefetch(i, n) (reference §25) is a hint with no effect on what a program
+// computes, wherever i and n fall: past either end, empty, or a slice.
+import std;
+
+simd fn total(a: const i32[:]) -> i64 {
+    var s: i64 = 0;
+    for r in a.len / 16 {
+        a.prefetch((r + 1) * 16 + 64, 16);
+        for j in 16 { s += a[r * 16 + j]; }
+    }
+    return s;
+}
+
+fn main() {
+    var a: i32[>..] = [];
+    for i in 1000 { a.push(i as i32); }
+    a.prefetch(-50, 100);
+    a.prefetch(990, 1000000);
+    a.prefetch(5000, 3);
+    a.prefetch(10, 0);
+    a.prefetch(10, -4);
+    let s = a[100..200];
+    s.prefetch(90, 20);
+    var f: f32[4] = [1.0; 4];
+    f.prefetch(0, 4);
+    print(total(a), " ", total(s), " ", f[3]);
+}
