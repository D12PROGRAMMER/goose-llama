new file mode 100644
index 0000000..d456c7b
--- /dev/null
+++ b/test/threads/queue_recycle_spin.goose
@@ -0,0 +1,43 @@
+// Queue nodes are recycled (gs_qrelease) across messages whose sizes grow
+// and shrink, a poll of an empty queue takes no lock, and a receive may spin
+// before it sleeps (os's queue_spin). pin_thread's answer is the platform's,
+// so only the call is made.
+import std;
+import os;
+
+struct Job { n: i32, body: u8[] }
+struct Done { n: i32, sum: i64, len: i64 }
+
+thread_fn worker() {
+    pin_thread(0);
+    loop {
+        let j = qget<Job>();
+        guard j.n >= 0 else { break; }
+        var s = 0;
+        for b in j.body { s += b; }
+        qput(Done { n: j.n, sum: s, len: j.body.len });
+    }
+}
+
+fn fill(n: i64) -> u8[>..] {
+    var p: u8[>..] = [];
+    for i in (n * 37) % 300 { p.push((i % 256) as! u8); }
+    return p;
+}
+
+fn main() {
+    queue_spin(2000);
+    let e, ok = qpoll<Done>();
+    print("empty poll: ", ok, " ", e.n);
+    let id = thread_spawn(worker);
+    var total = 0;
+    var bytes = 0;
+    for round in 20 {
+        for i in 10 { qput(Job { n: (round * 10 + i) as i32, body: fill(round * 10 + i) }); }
+        for i in 10 { let d = qget<Done>(); total += d.sum; bytes += d.len; }
+    }
+    qput(Job { n: -1, body: [] });
+    thread_wait(id);
+    queue_spin(0);
+    print("sum ", total, " bytes ", bytes);
+}
