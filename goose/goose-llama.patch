+// The kernels and every specialization a kernel's body calls, which get a
+// device copy (cuda.h).
+inline void CodeGen::FindDeviceSpecs() {
+    vector<FnSpec *> work;
+    for (auto sp : livespecs) if (sp->sf->iscuda) work.push_back(sp);
+    while (!work.empty()) {
+        auto sp = work.back();
+        work.pop_back();
+        if (!devspecs.insert(sp).second) continue;
+        function<void(Node *)> walk = [&](Node *n) {
+            if (!n) return;
+            if (auto c = Is<Call>(n)) {
+                if (c->spec && c->builtin < 0 && sinfo.count(c->spec)) work.push_back(c->spec);
+                for (auto k : c->dispatch) if (sinfo.count(k)) work.push_back(k);
+            }
+            RunChildren(n, walk);
+        };
+        walk(sp->body);
+    }
+    // What host code reaches, a kernel's callees among it, keeps its host form.
+    for (auto sp : livespecs) if (!devspecs.count(sp)) work.push_back(sp);
+    while (!work.empty()) {
+        auto sp = work.back();
+        work.pop_back();
+        if (sp->sf->iscuda || !hostspecs.insert(sp).second) continue;
+        function<void(Node *)> walk = [&](Node *n) {
+            if (!n) return;
+            if (auto c = Is<Call>(n)) {
+                if (c->spec && c->builtin < 0 && sinfo.count(c->spec)) work.push_back(c->spec);
+                for (auto k : c->dispatch) if (sinfo.count(k)) work.push_back(k);
+            }
+            RunChildren(n, walk);
+        };
+        walk(sp->body);
+    }
+}
