+}
+static inline void gs_dot_lanes_u8_0(float *r, const uint8_t *a, const int8_t *b) {
+    for (int k = 0; k < 8; k++)
+        r[k] = (float)(a[2 * k] * b[2 * k] + a[2 * k + 1] * b[2 * k + 1] +
