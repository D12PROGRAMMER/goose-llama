+/* os's pin_thread: binds the calling thread to logical CPU `cpu`, numbered
+   as the OS numbers them, so a worker pool can put one thread on each core
+   it chooses. true if the OS took it: on Windows the first 64 CPUs of the
+   thread's processor group, on Linux any the process may run on (the
+   system call itself, as gs_os_threads asks it); false elsewhere. */
+GS_API uint8_t gs_os_pin_thread(int64_t cpu) {
+    if (cpu < 0) return 0;
+#ifdef _WIN32
+    if (cpu >= 64) return 0;
+    return SetThreadAffinityMask(GetCurrentThread(), (DWORD_PTR)1 << cpu) != 0;
+#elif defined(__linux__)
+    unsigned long mask[1024 / (8 * sizeof(unsigned long))];
+    const int64_t bits = (int64_t)(8 * sizeof(unsigned long));
+    if (cpu >= (int64_t)(sizeof mask * 8)) return 0;
+    memset(mask, 0, sizeof mask);
+    mask[cpu / bits] |= 1UL << (cpu % bits);
+    return syscall(SYS_sched_setaffinity, 0, sizeof mask, mask) == 0;
+#else
+    return 0;
+#endif
+}
